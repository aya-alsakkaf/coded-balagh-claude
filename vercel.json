  },
  {
   "source": "/lesson-plan",
   "destination": "/staff/coded-balagh-claude-lesson-plan",
   "permanent": false
  },
  {
   "source": "/workshop-index",
   "destination": "/staff",
   "permanent": false
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    },
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  },
  {
   "source": "/staff/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "Cache-Control",
     "value": "private, no-store"
    }
   ]
  },
  {
   "source": "/staff",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "Cache-Control",
     "value": "private, no-store"
    }
   ]
  }
 ]
}
