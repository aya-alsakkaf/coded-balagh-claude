  },
  {
   "source": "/presenter-notes-day-1",
   "destination": "/staff/coded-balagh-claude-notes-day-1",
   "permanent": false
  },
  {
   "source": "/demo-runbook-day-1",
   "destination": "/staff/coded-balagh-claude-runbook-day-1",
   "permanent": false
  },
  {
   "source": "/backup-outputs-day-1",
   "destination": "/staff/coded-balagh-claude-backup-day-1",
